# Formaty environment variables
# Copy this file to `.env` and fill in values as needed. All variables are optional.

# Backend API base URL used by the Share feature (playground state persistence).
# When unset, sharing falls back to URL-encoded state in the hash.
# FORMATY_API_URL=https://api.formaty.pages.dev

# Canonical site URL used for metadata, sitemap, and Open Graph images.
SITE_URL=https://formaty.pages.dev

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# When set, gtag.js + page_view/event tracking are loaded on every page.
# Leave unset to keep the site fully tracking-free.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
